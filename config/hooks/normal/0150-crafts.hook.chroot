#!/bin/bash
# WordCraft / DeckCraft / GridCraft / PDFCraft (storytold, Apache-2.0): official .deb (x86_64 or aarch64) from GitHub releases,
# verified against each release's SHA256SUMS.txt before installing.
set -e
export DEBIAN_FRONTEND=noninteractive
case "$(dpkg --print-architecture)" in arm64) CARCH=aarch64 ;; *) CARCH=x86_64 ;; esac
mkdir -p /tmp/crafts && cd /tmp/crafts
fetch() {  # url dest
  for i in 1 2 3 4 5; do
    curl -fsSL --connect-timeout 20 --max-time 900 -o "$2" "$1" && return 0
    echo "download failed ($i/5): $1"; sleep 10
  done
  return 1
}
for spec in "wordcraft v0.12.0 0.12.0" "deckcraft v0.12.0 0.12.0" "gridcraft v0.13.0 0.13.0" "pdfcraft v0.15.0 0.15.0"; do
  set -- $spec
  base="https://github.com/storytold/$1/releases/download/$2"
  deb="$1-$3-linux-$CARCH.deb"
  fetch "$base/$deb" "$deb"
  fetch "$base/SHA256SUMS.txt" "$1.sums"
  want=$(grep " \*\?$deb\$" "$1.sums" | awk '{print $1}')
  have=$(sha256sum "$deb" | awk '{print $1}')
  [ -n "$want" ] && [ "$want" = "$have" ] || { echo "CHECKSUM MISMATCH for $deb (want=$want have=$have)"; exit 1; }
done
apt-get install -y --no-install-recommends ./*.deb
cd / && rm -rf /tmp/crafts
