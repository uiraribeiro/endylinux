#!/bin/bash
# Face unlock: fetch pinned OpenCV Zoo models (verified by sha256) and add the PAM rule to the LOGIN SCREEN only.
set -e
D=/usr/share/endy-face
mkdir -p "$D" /var/lib/endy-face
chmod 700 /var/lib/endy-face
SHA=c97242ce7f2a554e288b50eabd9f5df957e78801   # opencv_zoo commit (2022mar YuNet works with OpenCV 4.6 in Debian 12)
BASE="https://media.githubusercontent.com/media/opencv/opencv_zoo/$SHA/models"
fetch() {  # path-in-repo dest sha256
  for i in 1 2 3 4 5; do
    curl -fsSL --connect-timeout 20 --max-time 600 -o "$2" "$BASE/$1" \
      && [ "$(sha256sum "$2" | awk '{print $1}')" = "$3" ] && return 0
    echo "model download/verify failed ($i/5): $1"; sleep 10
  done
  return 1
}
fetch face_detection_yunet/face_detection_yunet_2022mar.onnx      "$D/face_detection_yunet_2022mar.onnx"   50ef07f702a31741ca46a4c0d947773b64143b9362780237bf0d427d6c79bab7
fetch face_recognition_sface/face_recognition_sface_2021dec.onnx "$D/face_recognition_sface_2021dec.onnx"  0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79
chmod 755 /usr/lib/endy-face/store.py /usr/local/bin/endy-face
# Face first, password always remains the fallback. Login screen only (not sudo / screen lock).
grep -q pam_endyface /etc/pam.d/lightdm || \
  sed -i '0,/^@include common-auth/s#^@include common-auth#auth sufficient pam_python.so /usr/lib/endy-face/pam_endyface.py\n@include common-auth#' /etc/pam.d/lightdm
grep -q pam_endyface /etc/pam.d/lightdm
